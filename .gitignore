# --- Roland-derived data is NOT redistributed (copyrighted). Regenerate it locally. ---
#
# This engine needs a legally obtained SCCore.dll from a Sound Canvas VA install. Everything
# below is derived from that DLL -- its wave ROM, its tables, or its runtime effect state -- and
# so is not ours to ship.
#
#   tabula-sonora extract-tables <SCCore.dll> tables/     -> tables/*.bin
#
# assets/manifest.json IS tracked: it is the offset map, not the data.
#
# ONE EXCEPTION, carried over from the C# project: assets/presets.json IS tracked. The reverb and
# chorus coefficients in it are Roland's, but they cannot be regenerated by everyone who needs
# them -- they are computed by the engine at start-up, so harvesting them means executing a
# 64-bit Windows binary. See the upstream NOTICE.md.

SCCore.dll
tables/

# Rendered audio and decoded samples: this is the wave ROM, one step removed.
*.wav
*.flac
*.f32
renders/

# Build output
build/
out/
cmake-build-*/

# vcpkg manifest-mode install tree
vcpkg_installed/

# Editors
.idea/
.vs/
.vscode/
.cache/
compile_commands.json

# macOS
.DS_Store

# Python tooling
__pycache__/
*.pyc
