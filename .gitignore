# --- Roland-derived data is NOT redistributed (copyrighted). Regenerate it locally. ---
#
# This engine needs a legally obtained SCCore.dll from a Sound Canvas VA install. Everything
# below is derived from that DLL -- its wave ROM, its tables, or its runtime effect state -- and
# so is not ours to ship.
#
#   tabula-sonora extract-tables tables/     -> tables/*.bin  (DLL from --dll or $TS_SCCORE_DLL)
#
# assets/manifest.json IS tracked: it is the offset map, not the data.
#
# There is no committed coefficient file. The reverb and chorus coefficients are encoded in the DLL
# and EffectProgrammer decodes them from your own copy -- see NOTICE.md.

SCCore.dll
tables/

# Differential fixtures: predictor streams and sampled outputs over the DLL's own data.
#   python3 tools/dump_predictors.py <SCCore.dll> fixtures/

# Test MIDI supplied by the user; not ours to redistribute either.
testdata/predictors.json
fixtures/

# Test MIDI supplied by the user; not ours to redistribute either.
testdata/

# Rendered audio and decoded samples: this is the wave ROM, one step removed.
*.wav
*.flac
*.f32
renders/

# Build output
build/
out/
cmake-build-*/

# The Emscripten engine module the web app imports; built by the `web` preset.
web/src/engine/generated/
web/node_modules/
web/dist/

# Netlify CLI per-machine state
.netlify/

# vcpkg manifest-mode install tree
vcpkg_installed/

# Editors
.idea/
.vs/
.vscode/
.cache/
compile_commands.json

# macOS
.DS_Store

# Python tooling
__pycache__/
*.pyc
