{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 24,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "VCPKG_MANIFEST_FEATURES": "tests;cli",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "debug",
      "displayName": "Debug",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "release",
      "displayName": "Release",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    },
    {
      "name": "cog",
      "displayName": "CogRelease",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_OSX_ARCHITECTURES": "x86_64;arm64",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "10.15"
      }
    },
    {
      "name": "asan",
      "displayName": "AddressSanitizer + UBSan",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_FLAGS": "-fsanitize=address,undefined -fno-sanitize=signed-integer-overflow,shift -fno-omit-frame-pointer",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address,undefined"
      }
    },
    {
      "name": "tsan",
      "displayName": "ThreadSanitizer",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_CXX_FLAGS": "-fsanitize=thread -fno-omit-frame-pointer",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=thread"
      }
    },
    {
      "name": "player",
      "displayName": "Release + terminal player and TUI",
      "inherits": "release",
      "binaryDir": "${sourceDir}/build/player",
      "cacheVariables": {
        "TS_BUILD_PLAYER": "ON",
        "TS_BUILD_TUI": "ON",
        "VCPKG_MANIFEST_FEATURES": "tests;cli;player;tui"
      }
    },
    {
      "name": "vs",
      "hidden": true,
      "generator": "Visual Studio 18 2026",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "VCPKG_MANIFEST_FEATURES": "tests;cli"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    { "name": "debug-vs", "displayName": "Debug (VS)", "inherits": "vs" },
    { "name": "release-vs", "displayName": "Release (VS)", "inherits": "vs" },
    {
      "name": "web",
      "displayName": "Emscripten web engine",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/web",
      "toolchainFile": "${sourceDir}/cmake/emscripten-toolchain.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_FLAGS": "-fwasm-exceptions",
        "TS_BUILD_WEB": "ON",
        "TS_BUILD_TESTS": "OFF",
        "TS_BUILD_CLI": "OFF",
        "TS_INSTALL": "OFF"
      }
    },
    {
      "name": "web-system",
      "displayName": "Emscripten web engine (distribution package)",
      "inherits": "web",
      "binaryDir": "${sourceDir}/build/web-system",
      "toolchainFile": "/usr/lib/emscripten/cmake/Modules/Platform/Emscripten.cmake"
    },
    {
      "name": "web-debug",
      "displayName": "Emscripten web engine (debug)",
      "inherits": "web",
      "binaryDir": "${sourceDir}/build/web-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_FLAGS": "-fwasm-exceptions -O1 -g"
      }
    },
    {
      "name": "player-vs",
      "displayName": "Player and TUI (VS)",
      "inherits": "vs",
      "cacheVariables": {
        "TS_BUILD_PLAYER": "ON",
        "TS_BUILD_TUI": "ON",
        "VCPKG_MANIFEST_FEATURES": "tests;cli;player;tui"
      }
    }
  ],
  "buildPresets": [
    { "name": "debug", "configurePreset": "debug" },
    { "name": "release", "configurePreset": "release" },
    { "name": "asan", "configurePreset": "asan" },
    { "name": "tsan", "configurePreset": "tsan" },
    { "name": "player", "configurePreset": "player" },
    { "name": "cog", "configurePreset": "cog" },
    { "name": "web", "configurePreset": "web" },
    { "name": "web-system", "configurePreset": "web-system" },
    { "name": "web-debug", "configurePreset": "web-debug" },
    { "name": "debug-vs", "configurePreset": "debug-vs", "configuration": "Debug" },
    { "name": "release-vs", "configurePreset": "release-vs", "configuration": "RelWithDebInfo" },
    { "name": "player-vs", "configurePreset": "player-vs", "configuration": "RelWithDebInfo" }
  ],
  "testPresets": [
    {
      "name": "base",
      "hidden": true,
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error", "stopOnFailure": false }
    },
    { "name": "debug", "inherits": "base", "configurePreset": "debug" },
    { "name": "release", "inherits": "base", "configurePreset": "release" },
    {
      "name": "asan",
      "inherits": "base",
      "configurePreset": "asan",
      "environment": {
        "TS_SONG_GATE_VARIANTS": "1"
      }
    },
    {
      "name": "tsan",
      "inherits": "base",
      "configurePreset": "tsan",
      "filter": { "include": { "label": "ring" } }
    },
    { "name": "debug-vs", "inherits": "base", "configurePreset": "debug-vs", "configuration": "Debug" },
    { "name": "release-vs", "inherits": "base", "configurePreset": "release-vs", "configuration": "RelWithDebInfo" }
  ]
}
